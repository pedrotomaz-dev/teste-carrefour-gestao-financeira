{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Database": {
    "Provider": "Postgres"
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=cashflow;Username=cashflow;Password=cashflow"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "Exchange": "cashflow.events",
    "Queue": "cashflow.consolidation",
    "DeadLetterExchange": "cashflow.events.dlx",
    "DeadLetterQueue": "cashflow.consolidation.dlq",
    "PrefetchCount": 20,
    "MaxConcurrency": 25
  }
}
